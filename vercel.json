{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/idspulse-app.apk",
      "destination": "https://github.com/shahrozmirzallc-arch/proud-lavoisier/releases/download/v1.0.1/idspulse-app.apk",
      "permanent": false
    },
    {
      "source": "/idspulse-app.zip",
      "destination": "https://github.com/shahrozmirzallc-arch/proud-lavoisier/releases/download/v1.0.1/idspulse-app.apk",
      "permanent": false
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
