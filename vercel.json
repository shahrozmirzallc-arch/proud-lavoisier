{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/idspulse-app.apk",
      "dest": "/idspulse-app.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=idspulse-app.apk"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
